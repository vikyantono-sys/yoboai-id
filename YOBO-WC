const fmtKey   = new Intl.DateTimeFormat("en-CA",{timeZone:TZ,year:"numeric",month:"2-digit",day:"2-digit"});
const fmtDay   = new Intl.DateTimeFormat("id-ID",{timeZone:TZ,weekday:"long",day:"numeric",month:"long"});
const fmtTime  = new Intl.DateTimeFormat("en-GB",{timeZone:TZ,hour:"2-digit",minute:"2-digit",hour12:false});
const fmtStamp = new Intl.DateTimeFormat("id-ID",{timeZone:TZ,day:"numeric",month:"short",hour:"2-digit",minute:"2-digit",hour12:false});

function dayLabelFromYMD(ymd){
  const p = String(ymd).split("-").map(Number);
  if(p.length<3||p.some(isNaN)) return "Jadwal menyusul";
  return new Intl.DateTimeFormat("id-ID",{timeZone:"UTC",weekday:"long",day:"numeric",month:"long"})
    .format(new Date(Date.UTC(p[0],p[1]-1,p[2])));
}
function enrich(m){
  if(m.kickoffUtc){
    const d = new Date(m.kickoffUtc);
    if(!isNaN(d.getTime())){
      m._key=fmtKey.format(d); m._day=fmtDay.format(d); m._time=fmtTime.format(d); m._ts=d.getTime();
      return m;
    }
  }
  m._key = m.wibDate || "TBD";
  m._time = m.wibTime || "TBD";
  m._day = m.wibDate ? dayLabelFromYMD(m.wibDate) : "Jadwal menyusul";
  m._ts = m.wibDate ? Date.parse((m.wibDate)+"T"+(m.wibTime||"00:00")+":00+07:00") : 8.64e15;
  if(isNaN(m._ts)) m._ts = 8.64e15;
  return m;
}

/* ============================================================ RENDER ============================================================ */
function render(){
  renderMatches();
  renderStandings();
  renderScorers();
  renderArisan();
  renderStats();
}

/* ---- Matches ---- */
function renderMatches(){
  const list = $("#matchList");
  let ms = DATA.matches.slice();
  const q = FILTER.q.trim().toLowerCase();
  ms = ms.filter(m=>{
    if(FILTER.status==="finished" && !isFinished(m)) return false;
    if(FILTER.status==="upcoming" && isFinished(m)) return false;
    if(FILTER.group && m.group!==FILTER.group) return false;
    if(q){
      const hay = [m.home,m.away,ownerOf(m.home),ownerOf(m.away)].filter(Boolean).join(" ").toLowerCase();
      if(hay.indexOf(q)===-1) return false;
    }
    return true;
  });

  if(!ms.length){ list.innerHTML = `<div class="empty">Tidak ada pertandingan yang cocok dengan filter.</div>`; return; }

  // finished -> newest first; upcoming -> soonest first; mixed -> chronological
  if(FILTER.status==="finished") ms.sort((a,b)=>b._ts-a._ts);
  else ms.sort((a,b)=>a._ts-b._ts);

  const groups = [];
  const byKey = {};
  ms.forEach(m=>{
    if(!byKey[m._key]){ byKey[m._key]={key:m._key,day:m._day,items:[]}; groups.push(byKey[m._key]); }
    byKey[m._key].items.push(m);
  });

  list.innerHTML = groups.map(g=>`
    <div class="daygroup">
      <div class="dayhead"><span>${esc(g.day)}</span><span class="rule"></span><span class="count">${g.items.length} laga</span></div>
      ${g.items.map(matchCard).join("")}
    </div>`).join("");
}

function matchCard(m){
  const fin = isFinished(m);
  const hWin = fin && m.homeScore>m.awayScore, aWin = fin && m.awayScore>m.homeScore;
  const center = fin
    ? `<div class="score">${m.homeScore}<span class="dash">–</span>${m.awayScore}</div><div class="meta ft">Selesai</div>`
    : `<div class="ko">${esc(m._time)}<small>WIB</small></div><div class="meta">${esc(stageLabel(m))}</div>`;
  const venue = (m.stadium||m.city)
    ? `<div class="venue"><span>${esc([m.stadium,m.city].filter(Boolean).join(" · "))}</span><span>${fin?esc(stageLabel(m)):("#"+esc(m.id||""))}</span></div>`
    : `<div class="venue"><span>${esc(stageLabel(m))}</span><span>#${esc(m.id||"")}</span></div>`;
  return `<div class="match">
    <div class="side home">
      ${flag(m.home)}
      <div class="team"><div class="name${hWin?" win":""}">${esc(m.home||"TBD")}</div>${ownerTag(m.home)}</div>
    </div>
    <div class="center">${center}</div>
    <div class="side away">
      ${flag(m.away)}
      <div class="team"><div class="name${aWin?" win":""}">${esc(m.away||"TBD")}</div>${ownerTag(m.away)}</div>
    </div>
    ${venue}
  </div>`;
}

/* ---- Standings ---- */
function renderStandings(){
  const wrap = $("#groupsWrap");
  const st = DATA.standings || {};
  const keys = Object.keys(st).sort();
  if(!keys.length){ wrap.innerHTML = `<div class="empty">Klasemen belum tersedia.</div>`; return; }
  wrap.innerHTML = keys.map(g=>{
    const rows = (st[g]||[]).slice().sort((a,b)=>(a.position||99)-(b.position||99));
    return `<div class="grouptable">
      <h3>Grup ${esc(g)}</h3>
      <table>
        <thead><tr>
          <th class="tname">Tim</th><th>M</th><th>M</th><th>S</th><th>K</th><th>SG</th><th>Poin</th>
        </tr></thead>
        <tbody>${rows.map(r=>{
          const ow = ownerOf(r.team);
          return `<tr class="${r.advanced?"adv":""}">
            <td class="tname"><div class="trow-team">
              <span class="pos">${r.position||""}</span>${flag(r.team)}
              <span style="min-width:0"><span class="nm">${esc(r.team)}</span>${ow?`<span class="ow">${esc(ow)}</span>`:""}</span>
            </div></td>
            <td>${r.played??0}</td><td>${r.won??0}</td><td>${r.drawn??0}</td><td>${r.lost??0}</td>
            <td>${(r.goalDifference>0?"+":"")+(r.goalDifference??0)}</td>
            <td class="pts">${r.points??0}</td>
          </tr>`;
        }).join("")}</tbody>
      </table>
    </div>`;
  }).join("");
}

/* ---- Top scorers ---- */
function renderScorers(){
  const list = $("#scorerList");
  const sc = (DATA.scorers||[]).filter(s=>s.goals>0);
  if(!sc.length){
    $("#scorerNote").textContent = "";
    list.innerHTML = `<div class="empty">Data pencetak gol belum tersedia di feed turnamen. Akan otomatis muncul begitu detail gol mulai masuk.</div>`;
    return;
  }
  const max = sc[0].goals || 1;
  $("#scorerNote").textContent = sc.length+" pemain";
  list.innerHTML = sc.slice(0,25).map((s,i)=>`
    <div class="scorer ${i<3?("top"+(i+1)):""}">
      <div class="rk">${i+1}</div>
      <div class="who"><div class="pl">${esc(s.player)}</div>
        <div class="tm">${flag(s.team)}<span>${esc(s.team||"")}</span></div></div>
      <div class="goals"><span class="bar"><i style="width:${Math.round(s.goals/max*100)}%"></i></span><span class="gnum">${s.goals}</span></div>
    </div>`).join("");
}

/* ---- Arisan owner leaderboard ---- */
function renderArisan(){
  const wrap = $("#arisanList");
  const owners = DATA.owners || {};
  if(!Object.keys(owners).length){
    wrap.innerHTML = `<div class="empty">Data kepemilikan arisan belum terbaca dari sheet Database.</div>`;
    return;
  }
  // team -> standings row
  const teamRow = {};
  Object.keys(DATA.standings||{}).forEach(g=>(DATA.standings[g]||[]).forEach(r=>{ teamRow[r.team]=r; }));
  // owner -> [teams]
  const byOwner = {};
  Object.keys(owners).forEach(team=>{ const o=owners[team]; (byOwner[o]=byOwner[o]||[]).push(team); });

  let rows = Object.keys(byOwner).map(owner=>{
    const teams = byOwner[owner];
    let pts=0,gf=0,ga=0,won=0,drawn=0,lost=0,alive=0,data=false;
    const detail = teams.map(t=>{
      const r = teamRow[t];
      if(r){ data=true; pts+=r.points||0; gf+=r.goalsFor||0; ga+=r.goalsAgainst||0;
        won+=r.won||0; drawn+=r.drawn||0; lost+=r.lost||0; if(r.advanced) alive++; }
      return { team:t, advanced: r? !!r.advanced : true };
    });
    return { owner, teams:detail, pts, gf, ga, gd:gf-ga, won, drawn, lost, alive, data };
  }).sort((a,b)=> b.pts-a.pts || b.gd-a.gd || b.gf-a.gf || a.owner.localeCompare(b.owner));

  wrap.innerHTML = rows.map((r,i)=>{
    const cls = i===0 ? "lead" : (i<3 ? "podium" : "");
    return `<div class="acard ${cls}">
      <div class="rank">${i+1}</div>
      <div class="aowner">
        <div class="onm">${esc(r.owner)}</div>
        <div class="ateams">${r.teams.map(t=>`<span class="ateam ${t.advanced?"":"out"}">${flag(t.team)}<span>${esc(t.team)}</span></span>`).join("")}</div>
      </div>
      <div class="astat">
        <div class="blk alivecol"><span class="v">${r.alive}/${r.teams.length}</span><span class="k">Hidup</span></div>
        <div class="blk"><span class="v">${(r.gd>0?"+":"")+r.gd}</span><span class="k">SG</span></div>
        <div class="blk"><span class="v pts">${r.pts}</span><span class="k">Poin</span></div>
      </div>
    </div>`;
  }).join("");
}

/* ---- Stats ---- */
function renderStats(){
  const fin = DATA.matches.filter(isFinished);
  const totalGoals = fin.reduce((s,m)=>s+m.homeScore+m.awayScore,0);
  const avg = fin.length ? (totalGoals/fin.length) : 0;

  // goals per team (finished only)
  const teamGoals = {}, teamConceded = {}, teamCS = {};
  fin.forEach(m=>{
    teamGoals[m.home]=(teamGoals[m.home]||0)+m.homeScore;
    teamGoals[m.away]=(teamGoals[m.away]||0)+m.awayScore;
    teamConceded[m.home]=(teamConceded[m.home]||0)+m.awayScore;
    teamConceded[m.away]=(teamConceded[m.away]||0)+m.homeScore;
    if(m.awayScore===0) teamCS[m.home]=(teamCS[m.home]||0)+1;
    if(m.homeScore===0) teamCS[m.away]=(teamCS[m.away]||0)+1;
  });
  const topScoringTeams = Object.keys(teamGoals).map(t=>({t,g:teamGoals[t]})).sort((a,b)=>b.g-a.g).slice(0,5);
  const cleanSheets = Object.keys(teamCS).map(t=>({t,g:teamCS[t]})).sort((a,b)=>b.g-a.g).slice(0,5);

  let biggest=null, highest=null;
  fin.forEach(m=>{
    const margin=Math.abs(m.homeScore-m.awayScore), tot=m.homeScore+m.awayScore;
    if(!biggest||margin>biggest.margin) biggest={m,margin};
    if(!highest||tot>highest.tot) highest={m,tot};
  });

  $("#statNote").textContent = fin.length+" laga selesai";
  $("#kpiWrap").innerHTML = `
    ${kpi(fin.length,"Laga Selesai")}
    ${kpi(totalGoals,"Total Gol",true)}
    ${kpi(avg.toFixed(2),"Gol / Laga")}
    ${kpi(Object.keys(DATA.standings||{}).length||"—","Grup")}`;

  const bigBlock = biggest ? `<div class="bigmatch">
      ${esc(biggest.m.home)} <span class="sc">${biggest.m.homeScore}–${biggest.m.awayScore}</span> ${esc(biggest.m.away)}
      <div class="sub">selisih ${biggest.margin} gol${biggest.m._day?` · ${esc(biggest.m._day)}`:""}</div></div>` : "—";
  const highBlock = highest ? `<div class="bigmatch">
      ${esc(highest.m.home)} <span class="sc">${highest.m.homeScore}–${highest.m.awayScore}</span> ${esc(highest.m.away)}
      <div class="sub">${highest.tot} gol dalam satu laga</div></div>` : "—";

  $("#statCols").innerHTML = `
    <div class="statbox"><h4>Tim Paling Subur</h4>
      ${topScoringTeams.length?topScoringTeams.map(x=>srow(x.t,x.g+" gol")).join(""):`<div class="empty">Belum ada data.</div>`}</div>
    <div class="statbox"><h4>Clean Sheet Terbanyak</h4>
      ${cleanSheets.length?cleanSheets.map(x=>srow(x.t,x.g+"×")).join(""):`<div class="empty">Belum ada.</div>`}</div>
    <div class="statbox"><h4>Kemenangan Terbesar</h4>${bigBlock}</div>
    <div class="statbox"><h4>Laga Paling Banyak Gol</h4>${highBlock}</div>`;
}
function kpi(v,k,green){ return `<div class="kpi"><div class="v${green?" g":""}">${v}</div><div class="k">${k}</div></div>`; }
function srow(team,val){ return `<div class="srow">${flag(team)}<span class="nm">${esc(team)}</span><span class="val">${esc(val)}</span></div>`; }

/* ---- group filter options ---- */
function fillGroups(){
  const sel = $("#groupSel");
  const gs = new Set();
  DATA.matches.forEach(m=>{ if(m.group) gs.add(m.group); });
  Object.keys(DATA.standings||{}).forEach(g=>gs.add(g));
  [...gs].sort().forEach(g=>{ const o=document.createElement("option"); o.value=g; o.textContent="Grup "+g; sel.appendChild(o); });
}

/* ============================================================ LOAD ============================================================ */
async function load(silent){
  const btn = $("#refreshBtn");
  if(!silent){ btn.disabled=true; btn.textContent="Memuat…"; }
  try{
    if(!DATA_URL || DATA_URL.indexOf("PASTE_YOUR")===0){
      throw new Error("DATA_URL belum diisi. Buka file ini dan tempel URL Web App Apps Script (diakhiri /exec) ke konstanta DATA_URL.");
    }
    const res = await fetch(DATA_URL, {cache:"no-store"});
    if(!res.ok) throw new Error("HTTP "+res.status);
    const json = await res.json();
    if(json.error) throw new Error(json.error);

    json.matches = (json.matches||[]).map(enrich);
    DATA = json;

    $("#boot").hidden = true;
    document.querySelectorAll('section[data-tab]').forEach(s=>{ if(s.dataset.tab===currentTab) s.hidden=false; });
    if(!$("#groupSel").dataset.filled){ fillGroups(); $("#groupSel").dataset.filled="1"; }

    render();

    const upd = json.updatedAt ? fmtStamp.format(new Date(json.updatedAt)) : "";
    $("#updated").textContent = "Update "+upd+" WIB";
    const anyLive = false; // live endpoint is Pro-only; keep dot steady
    $("#liveDot").classList.toggle("live", anyLive);
    $("#footMeta").textContent = "Data: Zafronix World Cup API · "+(json.matches.length)+" laga";
  }catch(err){
    if(!DATA){
      $("#boot").hidden=false;
      $("#boot").innerHTML = `<h3>Gagal memuat data</h3>
        <p>${esc(err.message)}</p>
        <p style="margin-top:14px">Pastikan <code>DATA_URL</code> berisi URL Web App Apps Script kamu, dan deployment-nya
        diatur <code>Who has access: Anyone</code>. Lalu klik Refresh.</p>`;
    }
  }finally{
    btn.disabled=false; btn.textContent="Refresh";
  }
}

/* ---- tabs ---- */
let currentTab = "matches";
$("#tabbar").addEventListener("click", e=>{
  const t = e.target.closest(".tab"); if(!t) return;
  currentTab = t.dataset.target;
  document.querySelectorAll(".tab").forEach(x=>x.setAttribute("aria-selected", x===t ? "true":"false"));
  document.querySelectorAll('section[data-tab]').forEach(s=> s.hidden = (s.dataset.tab!==currentTab) || !DATA );
});

/* ---- filters ---- */
$("#statusSeg").addEventListener("click", e=>{
  const b=e.target.closest("button"); if(!b) return;
  FILTER.status=b.dataset.status;
  [...e.currentTarget.children].forEach(x=>x.setAttribute("aria-pressed", x===b?"true":"false"));
  renderMatches();
});
$("#groupSel").addEventListener("change", e=>{ FILTER.group=e.target.value; renderMatches(); });
let qt; $("#searchInp").addEventListener("input", e=>{ clearTimeout(qt); qt=setTimeout(()=>{ FILTER.q=e.target.value; renderMatches(); },120); });
$("#refreshBtn").addEventListener("click", ()=>load(false));

/* ---- gentle auto-refresh while the tab is visible ---- */
setInterval(()=>{ if(!document.hidden && DATA) load(true); }, 180000);

load(false);
</script>
