<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Arisan · Piala Dunia 2026 — YoboLabs</title>
<meta name="description" content="Hasil, klasemen, top skor & arisan kantor YoboLabs untuk Piala Dunia 2026. Semua waktu WIB.">
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
<style>
  /* ===== YoboLabs brand tokens ===== */
  :root{
    --green:#6FED45;            /* exact brand green — never tinted */
    --black:#000000;            /* pure black, no off-black */
    --white:#FFFFFF;
    --ink-2:#C8C8CE;            /* secondary text on black */
    --ink-3:#85858E;            /* metadata / captions (brand graphite family) */
    --panel:rgba(255,255,255,0.035);
    --panel-2:rgba(255,255,255,0.06);
    --line:rgba(255,255,255,0.08);
    --line-2:rgba(255,255,255,0.14);
    --win:var(--green);
    --font:'Satoshi','Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'JetBrains Mono',ui-monospace,'SF Mono',Menlo,monospace;
    --maxw:1080px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--black);
    color:var(--white);
    font-family:var(--font);
    font-size:15px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    padding-bottom:64px;
  }
  a{color:inherit}
  ::selection{background:var(--green);color:var(--black)}

  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 20px}

  /* ===== Masthead ===== */
  .masthead{
    border-bottom:1px solid var(--line);
    padding:22px 0 18px;
    position:relative;
  }
  .masthead::after{ /* green hairline accent */
    content:"";position:absolute;left:0;bottom:-1px;height:1px;width:120px;background:var(--green);
  }
  .masthead .wrap{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .brandblock{display:flex;align-items:center;gap:16px;min-width:0}
  svg.logo{height:30px;width:auto;display:block;flex:none}
  .titles{min-width:0}
  .eyebrow{
    font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-3);
    font-weight:700;margin:0 0 2px;
  }
  .title{
    font-size:21px;font-weight:900;letter-spacing:-.01em;margin:0;line-height:1.05;
  }
  .title .yr{color:var(--green)}
  .status{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .pill{
    display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-2);
    font-family:var(--mono);font-weight:500;
  }
  .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(111,237,69,.6);}
  .dot.live{animation:pulse 2.2s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(111,237,69,.5)}70%{box-shadow:0 0 0 7px rgba(111,237,69,0)}100%{box-shadow:0 0 0 0 rgba(111,237,69,0)}}
  .refresh{
    appearance:none;border:1px solid var(--line-2);background:transparent;color:var(--white);
    font-family:var(--mono);font-size:12px;font-weight:500;padding:7px 12px;border-radius:8px;cursor:pointer;
    transition:border-color .15s,background .15s;
  }
  .refresh:hover{border-color:var(--green)}
  .refresh:active{background:var(--panel-2)}
  .refresh[disabled]{opacity:.5;cursor:default}

  /* ===== Tabs ===== */
  nav.tabs{position:sticky;top:0;z-index:20;background:rgba(0,0,0,.86);backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);}
  .tabs .wrap{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}
  .tabs .wrap::-webkit-scrollbar{display:none}
  .tab{
    appearance:none;background:none;border:none;color:var(--ink-3);cursor:pointer;
    font-family:var(--font);font-weight:700;font-size:14px;letter-spacing:.01em;
    padding:15px 14px 13px;border-bottom:2px solid transparent;white-space:nowrap;
    transition:color .15s;
  }
  .tab:hover{color:var(--ink-2)}
  .tab[aria-selected="true"]{color:var(--white);border-bottom-color:var(--green)}

  main{padding-top:26px}
  section[data-tab]{animation:fade .25s ease}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  [hidden]{display:none!important}

  .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 0 14px;flex-wrap:wrap}
  .sec-title{font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin:0}
  .sec-note{font-size:12px;color:var(--ink-3);font-family:var(--mono)}

  /* ===== Filters ===== */
  .filters{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
  .seg{display:inline-flex;border:1px solid var(--line-2);border-radius:9px;overflow:hidden}
  .seg button{
    appearance:none;background:none;border:none;color:var(--ink-2);cursor:pointer;
    font-family:var(--font);font-weight:700;font-size:13px;padding:8px 14px;transition:.15s;
  }
  .seg button[aria-pressed="true"]{background:var(--green);color:var(--black)}
  select,input.search{
    appearance:none;background:var(--panel);border:1px solid var(--line-2);color:var(--white);
    font-family:var(--font);font-size:13px;font-weight:600;padding:8px 12px;border-radius:9px;
  }
  select:focus,input.search:focus{outline:none;border-color:var(--green)}
  input.search{min-width:200px;flex:1}
  input.search::placeholder{color:var(--ink-3)}

  /* ===== Matchday + match cards ===== */
  .daygroup{margin-bottom:26px}
  .dayhead{
    display:flex;align-items:center;gap:12px;margin:0 0 10px;
    font-size:12px;font-weight:800;letter-spacing:.04em;color:var(--ink-2);text-transform:capitalize;
  }
  .dayhead .rule{height:1px;flex:1;background:var(--line)}
  .dayhead .count{font-family:var(--mono);color:var(--ink-3);font-weight:500;letter-spacing:0}

  .match{
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;
    border:1px solid var(--line);border-radius:14px;background:var(--panel);
    padding:14px 16px;margin-bottom:10px;transition:border-color .15s,background .15s;
  }
  .match:hover{border-color:var(--line-2);background:var(--panel-2)}
  .side{display:flex;align-items:center;gap:11px;min-width:0}
  .side.away{flex-direction:row-reverse;text-align:right}
  .flag{width:28px;height:21px;border-radius:3px;object-fit:cover;flex:none;
    box-shadow:0 0 0 1px rgba(255,255,255,.12);background:#222}
  .flag--none{display:inline-flex;align-items:center;justify-content:center;font-family:var(--mono);
    font-size:10px;font-weight:700;color:var(--ink-2)}
  .team{min-width:0}
  .team .name{font-weight:700;font-size:15px;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .team .name.win{color:var(--win)}
  .owner{display:inline-block;margin-top:3px;font-size:11px;font-family:var(--mono);color:var(--ink-3);
    font-weight:500;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
  .owner::before{content:"◦ ";color:var(--green)}
  .owner.none{display:none}

  .center{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:78px}
  .score{font-family:var(--mono);font-weight:800;font-size:24px;letter-spacing:.02em;line-height:1}
  .score .dash{color:var(--ink-3);margin:0 5px;font-weight:500}
  .vs{font-family:var(--mono);font-size:13px;color:var(--ink-3);font-weight:500}
  .ko{font-family:var(--mono);font-size:15px;font-weight:700;color:var(--white)}
  .ko small{display:block;font-size:9px;color:var(--ink-3);letter-spacing:.12em;font-weight:500;margin-top:1px}
  .meta{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);font-weight:700}
  .meta.ft{color:var(--green)}

  .venue{grid-column:1/-1;margin-top:9px;padding-top:9px;border-top:1px solid var(--line);
    font-size:11px;color:var(--ink-3);font-family:var(--mono);font-weight:500;
    display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}

  /* ===== Standings ===== */
  .groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .grouptable{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel)}
  .grouptable h3{margin:0;padding:11px 14px;font-size:12px;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--ink-2);border-bottom:1px solid var(--line);background:var(--panel-2)}
  table{width:100%;border-collapse:collapse;font-size:13px}
  thead th{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--ink-3);letter-spacing:.06em;
    text-align:center;padding:8px 4px;border-bottom:1px solid var(--line)}
  thead th.tname{text-align:left;padding-left:14px}
  tbody td{padding:9px 4px;text-align:center;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
  tbody tr:last-child td{border-bottom:none}
  td.tname{text-align:left;padding-left:14px}
  .trow-team{display:flex;align-items:center;gap:9px;min-width:0}
  .trow-team .flag{width:22px;height:16px}
  .trow-team .nm{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .trow-team .ow{font-size:10px;color:var(--ink-3);font-family:var(--mono);font-weight:500;display:block;line-height:1.1}
  .pos{font-family:var(--mono);color:var(--ink-3);font-weight:700;width:26px}
  td.pts{font-family:var(--mono);font-weight:800;color:var(--white)}
  tr.adv{position:relative}
  tr.adv td:first-child{box-shadow:inset 3px 0 0 var(--green)}
  tr.adv .pos{color:var(--green)}
  .legend{font-size:11px;color:var(--ink-3);font-family:var(--mono);margin-top:14px;display:flex;align-items:center;gap:8px}
  .legend i{width:3px;height:14px;background:var(--green);display:inline-block;border-radius:2px}

  /* ===== Scorers ===== */
  .scorer{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:12px;
    padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:var(--panel);margin-bottom:8px}
  .scorer .rk{font-family:var(--mono);font-weight:800;font-size:15px;color:var(--ink-3);text-align:center}
  .scorer.top1 .rk,.scorer.top2 .rk,.scorer.top3 .rk{color:var(--green)}
  .scorer .who{min-width:0}
  .scorer .pl{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .scorer .tm{font-size:11px;color:var(--ink-3);font-family:var(--mono);display:flex;align-items:center;gap:7px;margin-top:2px}
  .scorer .tm .flag{width:18px;height:13px}
  .goals{display:flex;align-items:center;gap:10px}
  .bar{width:120px;height:7px;border-radius:4px;background:var(--line);overflow:hidden}
  .bar > i{display:block;height:100%;background:var(--green);border-radius:4px}
  .gnum{font-family:var(--mono);font-weight:800;font-size:16px;min-width:22px;text-align:right}
  @media(max-width:560px){.bar{width:64px}}

  /* ===== Arisan leaderboard ===== */
  .arisan{display:flex;flex-direction:column;gap:10px}
  .acard{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px 16px;
    display:grid;grid-template-columns:40px 1fr auto;gap:14px;align-items:center}
  .acard.lead{border-color:var(--green)}
  .acard .rank{font-family:var(--mono);font-weight:800;font-size:20px;text-align:center;color:var(--ink-3)}
  .acard.lead .rank,.acard.podium .rank{color:var(--green)}
  .aowner{min-width:0}
  .aowner .onm{font-weight:800;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ateams{display:flex;gap:14px;margin-top:5px;flex-wrap:wrap}
  .ateam{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-2);font-weight:600}
  .ateam .flag{width:20px;height:15px}
  .ateam.out{opacity:.45;text-decoration:line-through}
  .astat{display:flex;gap:18px;text-align:right}
  .astat .blk{display:flex;flex-direction:column;align-items:flex-end}
  .astat .v{font-family:var(--mono);font-weight:800;font-size:18px;line-height:1}
  .astat .v.pts{color:var(--green)}
  .astat .k{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:700;margin-top:3px}
  @media(max-width:560px){.astat{gap:12px}.astat .alivecol{display:none}}

  /* ===== Stats ===== */
  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
  .kpi{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:16px}
  .kpi .v{font-family:var(--mono);font-weight:800;font-size:30px;line-height:1;letter-spacing:-.01em}
  .kpi .v.g{color:var(--green)}
  .kpi .k{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:700;margin-top:8px}
  .statcols{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .statbox{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:16px}
  .statbox h4{margin:0 0 12px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);font-weight:800}
  .srow{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px}
  .srow:last-child{border-bottom:none}
  .srow .flag{width:20px;height:15px}
  .srow .nm{font-weight:700;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .srow .val{font-family:var(--mono);font-weight:800}
  .bigmatch{font-size:14px;font-weight:700;line-height:1.4}
  .bigmatch .sc{font-family:var(--mono);color:var(--green)}
  .bigmatch .sub{font-size:11px;color:var(--ink-3);font-family:var(--mono);font-weight:500;margin-top:4px}

  /* ===== States ===== */
  .state{text-align:center;padding:70px 20px;color:var(--ink-3)}
  .state .spin{width:26px;height:26px;border:2px solid var(--line-2);border-top-color:var(--green);
    border-radius:50%;margin:0 auto 16px;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .state h3{color:var(--white);font-size:16px;margin:0 0 8px}
  .state p{margin:0 auto;max-width:460px;font-size:13px;line-height:1.6}
  .state code{font-family:var(--mono);color:var(--green);font-size:12px}
  .empty{padding:40px 16px;text-align:center;color:var(--ink-3);font-size:13px;
    border:1px dashed var(--line-2);border-radius:14px}

  footer{border-top:1px solid var(--line);margin-top:40px;padding:22px 0;color:var(--ink-3);font-size:12px}
  footer .wrap{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;align-items:center}
  footer .mono{font-family:var(--mono)}

  @media(max-width:720px){
    .groups{grid-template-columns:1fr}
    .statcols{grid-template-columns:1fr}
    .kpis{grid-template-columns:repeat(2,1fr)}
    .title{font-size:19px}
    .match{padding:13px 13px}
    .team .name{font-size:14px}
  }
  @media(prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
  }
</style>
</head>
